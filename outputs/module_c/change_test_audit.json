  "alias_mapping": {
    "T1": [
      {
        "team_rule_id": "r-4fcfc494ad65ecf8a906",
        "title": "Coercing adoption of common-pricing-algorithm recommendations",
        "status_at_2026_10_01": "in_force",
        "effective_date": "2026-01-01",
        "citation": "Business and Professions Code § 16729(b), (c), (d), added by AB 325, Chapter 338",
        "source_doc_id": "D022",
        "source_url": "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260AB325",
        "retrieved_at": "2026-10-01T22:35Z",
        "quoted_span": "(b) It shall be unlawful for a person to use or distribute a common pricing algorithm if the person coerces another person to set or adopt a recommended price or commercial term recommended by the common pricing algorithm for the same or similar products or services in the jurisdiction of this state.",
        "as_of": "2026-10-01"
      },
      {
        "team_rule_id": "r-6f96ebe74c183e607f78",
        "title": "Common pricing algorithms used in unlawful restraints of trade",
        "status_at_2026_10_01": "in_force",
        "effective_date": "2026-01-01",
        "citation": "Business and Professions Code § 16729(a), (c), (d), added by AB 325, Chapter 338",
        "source_doc_id": "D022",
        "source_url": "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260AB325",
        "retrieved_at": "2026-10-01T22:35Z",
        "quoted_span": "(a) It shall be unlawful for a person to use or distribute a common pricing algorithm as part of a contract, combination in the form of a trust, or conspiracy to restrain trade or commerce in violation of this chapter.",
        "as_of": "2026-10-01"
      }
    ],
    "T2": [
      {
        "team_rule_id": "r-8635dda969781a251d31",
        "title": "Software-based coordination or recommendation of rental terms prohibited",
        "status_at_2026_10_01": "in_force",
        "effective_date": "2025-07",
        "citation": "Hoboken City Code, ch. 158-2",
        "source_doc_id": "D037",
        "source_url": "https://www.morganlewis.com/pubs/2026/08/algorithmic-rent-pricing-litigation-expands-under-new-state-and-local-laws",
        "retrieved_at": "2026-10-03T20:12:36Z",
        "quoted_span": "Prohibits landlords from using software, algorithms or data-sharing platforms to coordinate or recommend rents, lease terms, or occupancy.",
        "as_of": "2026-10-01"
      },
      {
        "team_rule_id": "r-72e6795a9b3404d2d4a8",
        "title": "Landlord use of algorithmic rent coordination services prohibited",
        "status_at_2026_10_01": "in_force",
        "effective_date": "2025-06",
        "citation": "Jersey City Code § 218-12",
        "source_doc_id": "D037",
        "source_url": "https://www.morganlewis.com/pubs/2026/08/algorithmic-rent-pricing-litigation-expands-under-new-state-and-local-laws",
        "retrieved_at": "2026-10-03T20:12:36Z",
        "quoted_span": "Prohibits a landlord’s use of algorithmic rent coordination services; includes public and private enforcement; fines up to $2,000 per day.",
        "as_of": "2026-10-01"
      }
    ],
    "T3": [
      {
        "team_rule_id": "r-10e8f85ab60bca6a6246",
        "title": "Two or more persons engaging in or facilitating parallel pricing coordination",
        "status_at_2026_10_01": "not_yet_effective",
        "effective_date": "2027-07-01",
        "citation": "P.L. 2026, c.43, §4(c) (Forbidding the Algorithmic Inflation of Rent (FAIR) Act)",
        "source_doc_id": "D069",
        "source_url": "https://pub.njleg.state.nj.us/Bills/2026/AL26/43_.HTM",
        "retrieved_at": "2026-10-01T22:56Z",
        "quoted_span": "two or more persons to engage in\n1\nor\notherwise facilitate\n1\nparallel pricing coordination;",
        "as_of": "2026-10-01"
      },
      {
        "team_rule_id": "r-3c8d21243cccf224902e",
        "title": "Parallel pricing coordination by a coordinator's agents, representatives, or subcontractors",
        "status_at_2026_10_01": "not_yet_effective",
        "effective_date": "2027-07-01",
        "citation": "P.L. 2026, c.43, §4(d) (Forbidding the Algorithmic Inflation of Rent (FAIR) Act)",
        "source_doc_id": "D069",
        "source_url": "https://pub.njleg.state.nj.us/Bills/2026/AL26/43_.HTM",
        "retrieved_at": "2026-10-01T22:56Z",
        "quoted_span": "any agent or representative of a coordinator or\nsubcontractor thereof to engage in parallel pricing coordination;",
        "as_of": "2026-10-01"
      },
      {
        "team_rule_id": "r-6c3b1b734e206938c6fe",
        "title": "Coordinator facilitation of anticompetitive agreements",
        "status_at_2026_10_01": "not_yet_effective",
        "effective_date": "2027-07-01",
        "citation": "P.L. 2026, c.43, §4(b) (Forbidding the Algorithmic Inflation of Rent (FAIR) Act)",
        "source_doc_id": "D069",
        "source_url": "https://pub.njleg.state.nj.us/Bills/2026/AL26/43_.HTM",
        "retrieved_at": "2026-10-01T22:56Z",
        "quoted_span": "a coordinator to facilitate a tacit or express\nagreement among rental property owners that restricts competition with respect\nto residential dwelling units, including by performing a coordinating\nfunction;",
        "as_of": "2026-10-01"
      },
      {
        "team_rule_id": "r-7c2cfc7fe63d43dd3b48",
        "title": "Prohibition on obtaining a coordinator's services",
        "status_at_2026_10_01": "not_yet_effective",
        "effective_date": "2027-07-01",
        "citation": "P.L. 2026, c.43, §4(a) (Forbidding the Algorithmic Inflation of Rent (FAIR) Act)",
        "source_doc_id": "D069",
        "source_url": "https://pub.njleg.state.nj.us/Bills/2026/AL26/43_.HTM",
        "retrieved_at": "2026-10-01T22:56Z",
        "quoted_span": "a rental property owner, or any agent,\nrepresentative, or subcontractor thereof, to receive, subscribe to, contract\nfor, or otherwise exchange any form of consideration in return for the use of,\nthe services of a coordinator;",
        "as_of": "2026-10-01"
      },
      {
        "team_rule_id": "r-a771d2ac4dec0e8aaa22",
        "title": "Any person prohibited from performing a coordinating function",
        "status_at_2026_10_01": "not_yet_effective",
        "effective_date": "2027-07-01",
        "citation": "P.L. 2026, c.43, §4(e) (Forbidding the Algorithmic Inflation of Rent (FAIR) Act)",
        "source_doc_id": "D069",
        "source_url": "https://pub.njleg.state.nj.us/Bills/2026/AL26/43_.HTM",
        "retrieved_at": "2026-10-01T22:56Z",
        "quoted_span": "any person to perform a coordinating function.",
        "as_of": "2026-10-01"
      }
    ],
